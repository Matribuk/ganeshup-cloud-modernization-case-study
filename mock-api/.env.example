#TO-BE (cloud-native) -> npm run dev

# Port Node.js
PORT=3000

# App version
APP_VERSION=v2.0.0-cloud-native

# AWS / LocalStack Config
AWS_REGION=ca-central-1
LOCALSTACK_ENDPOINT=http://localhost:4566
APP_SECRET_ID=prod/ganeshup/backend-env


# AS-IS (legacy) -> npm run dev:as-is

# APP_VERSION=v1.0.0-legacy

# Filesystem storage (As-Is #1 bottleneck)
# UPLOAD_DIR=./uploads

# connection string PostgreSQL (As-Is #4 bottleneck)
# DATABASE_URL=postgresql://ganeshup_user:local_rds_password@localhost:5432/ganeshup_db
